# Supabase project URL.
# Development example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key.
# This key is public by design and can be used in browser/client code with RLS enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role / secret key.
# Server-side only. Never expose this value in Client Components, browser code, logs, or public repos.
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL.
# Development: http://localhost:3000
# Production: https://SEU-DOMINIO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional public analytics IDs for paid traffic / conversion tracking.
# Leave blank to disable. Do not put private API secrets here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional public contact e-mail shown in Terms/Privacy.
# Fallback in the app: radarconcursosbr@gmail.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional external checkout URL for Radar Premium.
# Leave blank while Mercado Pago/checkout is not configured.
NEXT_PUBLIC_PREMIUM_CHECKOUT_URL=
